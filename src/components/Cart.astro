---
import { contact, pickupHours } from '../data/menu';
---

<dialog class="cart" data-cart aria-labelledby="cart-title" data-email={contact.email} data-hours={JSON.stringify(pickupHours)}>
  <div class="cart-inner">
    <header>
      <h2 id="cart-title">Your order</h2>
      <button type="button" class="close" data-cart-close aria-label="Close your order">×</button>
    </header>

    <p class="empty" data-cart-empty>Your order is empty. Pick a sip from the <a href="/menu/">menu</a>.</p>
    <ul class="lines" data-cart-lines></ul>

    <footer data-cart-footer hidden>
      <div class="total"><span>Subtotal</span><strong data-cart-total>$0.00</strong></div>
      <p class="note">Online payment is coming soon. Tap below to email your order to us and we'll reply to confirm a pickup time.</p>
      <form class="details" data-cart-form novalidate>
        <label><span class="lbl">Your name</span><input name="name" autocomplete="name" required /></label>
        <label><span class="lbl">Phone <span>(optional)</span></span><input name="phone" type="tel" autocomplete="tel" /></label>
        <div class="pickup">
          <label><span class="lbl">Pickup date</span><input name="date" type="date" required data-pickup-date /></label>
          <label><span class="lbl">Pickup time</span><select name="time" required data-pickup-time></select></label>
        </div>
        <label><span class="lbl">Notes <span>(optional)</span></span><textarea name="notes" rows="2"></textarea></label>
        <button class="btn" type="submit" data-cart-send>Email my order</button>
        <p class="note" data-cart-fallback>No email app? Send your order to <a data-cart-mailto></a>.</p>
      </form>
      <button type="button" class="clear" data-cart-clear>Clear order</button>
    </footer>
  </div>
</dialog>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<style>
  .cart {
    margin: 0 0 0 auto;
    height: 100dvh;
    max-height: none;
    width: min(100%, 420px);
    border: 0;
    padding: 0;
    background: var(--white);
    color: var(--ink);
    box-shadow: -20px 0 50px -30px rgba(58, 43, 48, 0.4);
  }
  .cart::backdrop { background: rgba(58, 43, 48, 0.35); }
  .cart[open] { animation: slide 0.25s ease-out; }
  @keyframes slide { from { transform: translateX(40px); opacity: 0; } }
  .cart-inner { display: flex; flex-direction: column; height: 100%; padding: 28px; }
  header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); padding-bottom: 14px; margin-bottom: 18px; }
  h2 { font-size: 2rem; margin: 0; }
  .close { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: none; font-size: 1.5rem; line-height: 1; cursor: pointer; color: var(--ink); }
  .empty { color: var(--muted); }
  .lines { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
  .lines :global(li) { display: grid; grid-template-columns: 56px 1fr auto; gap: 14px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .lines :global(img) { width: 56px; height: 56px; }
  .lines :global(.name) { font: 600 1.15rem/1.2 var(--serif); }
  .lines :global(.meta) { font-size: 0.82rem; color: var(--muted); }
  .lines :global(.qty) { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; }
  .lines :global(.qty button) { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--gold); background: var(--white); cursor: pointer; color: var(--ink); line-height: 1; }
  .lines :global(.price) { font-weight: 500; }
  footer { border-top: 1px solid var(--line); padding-top: 18px; display: grid; gap: 12px; }
  footer[hidden] { display: none; }
  .total { display: flex; justify-content: space-between; font-size: 1.1rem; }
  .note { font-size: 0.85rem; color: var(--muted); margin: 0; }
  .details { display: grid; gap: 10px; }
  .details label { display: grid; gap: 4px; font-size: 0.85rem; font-weight: 500; }
  .details .lbl span { color: var(--muted); font-weight: 400; }
  .details input, .details textarea { font: inherit; font-size: 0.95rem; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); }
  .note a { color: inherit; }
  .pickup { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .details select { font: inherit; font-size: 0.95rem; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); min-height: 42px; }
  .details select:focus { outline: 2px solid var(--gold); outline-offset: 1px; }
  .details input:focus, .details textarea:focus { outline: 2px solid var(--gold); outline-offset: 1px; }
  .cart-inner { overflow-y: auto; }
  .lines { flex: 0 0 auto; overflow: visible; }
  .empty { flex: 1; }
  .clear { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font: inherit; font-size: 0.85rem; }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 20px);
    background: var(--ink);
    color: var(--white);
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 0.9rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
    z-index: 50;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
</style>

<script>
  type Line = { key: string; id: string; name: string; size: string; oz: number; price: number; img: string; qty: number };
  const KEY = 'sip-society-order';
  const $ = <T extends Element>(s: string) => document.querySelector(s) as T;
  const dialog = $<HTMLDialogElement>('[data-cart]');
  const money = (n: number) => `$${n.toFixed(2)}`;

  const load = (): Line[] => {
    try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
  };
  let lines: Line[] = load();
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(lines)); } catch {} };

  function render() {
    const count = lines.reduce((n, l) => n + l.qty, 0);
    const total = lines.reduce((n, l) => n + l.qty * l.price, 0);
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
      el.hidden = count === 0;
    });
    $<HTMLElement>('[data-cart-empty]').hidden = count > 0;
    $<HTMLElement>('[data-cart-footer]').hidden = count === 0;
    $<HTMLElement>('[data-cart-total]').textContent = money(total);
    const ul = $<HTMLUListElement>('[data-cart-lines]');
    ul.replaceChildren(
      ...lines.map((l) => {
        const li = document.createElement('li');
        li.innerHTML = `<img src="${l.img}" alt="" width="56" height="56">
          <div><div class="name"></div><div class="meta"></div>
          <div class="qty"><button type="button" data-dec aria-label="One less">−</button><span></span><button type="button" data-inc aria-label="One more">+</button></div></div>
          <div class="price"></div>`;
        li.querySelector('.name')!.textContent = l.name;
        li.querySelector('.meta')!.textContent = `${l.size} · ${l.oz} oz · ${money(l.price)} each`;
        li.querySelector('.qty span')!.textContent = String(l.qty);
        li.querySelector('.price')!.textContent = money(l.price * l.qty);
        li.querySelector('[data-dec]')!.addEventListener('click', () => change(l.key, -1));
        li.querySelector('[data-inc]')!.addEventListener('click', () => change(l.key, 1));
        return li;
      }),
    );
  }

  const orderText = () =>
    lines.map((l) => `${l.qty} × ${l.name} (${l.size}, ${l.oz} oz) — ${money(l.price * l.qty)}`).join('\n');
  const subtotal = () => lines.reduce((n, l) => n + l.qty * l.price, 0);

  // Opens the customer's own email app with the order filled in, addressed
  // to the order inbox. Replying to that email goes straight to the customer.
  function mailtoHref(d: Record<string, string>) {
    const subject = `Sip Society order${d.name ? ` from ${d.name}` : ''} · ${money(subtotal())}`;
    const body =
      `Hi Sip Society!\n\nI'd like to order:\n\n${orderText()}\n\nSubtotal: ${money(subtotal())}\n\n` +
      `Name: ${d.name || ''}\nPhone: ${d.phone || ''}\nPickup: ${pickupText(d.date, d.time)}\nNotes: ${d.notes || ''}\n`;
    return `mailto:${dialog.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }

  // Pickup date and time. Dates before today can't be picked, and on today's
  // date only times at least LEAD_MIN from now are offered.
  const LEAD_MIN = 30;
  const STEP_MIN = 15;
  const MAX_DAYS_AHEAD = 30;
  const hours: [number, number][] = JSON.parse(dialog.dataset.hours || '[]');
  // The shop is in Illinois, so "today" and "now" use Central time no matter
  // where the customer's device thinks it is.
  const SHOP_TZ = 'America/Chicago';
  function shopNow(): Date {
    const p = Object.fromEntries(
      new Intl.DateTimeFormat('en-US', {
        timeZone: SHOP_TZ, hourCycle: 'h23',
        year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric',
      }).formatToParts(new Date()).map((x) => [x.type, x.value]),
    );
    return new Date(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute);
  }
  const dateInput = $<HTMLInputElement>('[data-pickup-date]');
  const timeSelect = $<HTMLSelectElement>('[data-pickup-time]');
  const isoDate = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const parseDate = (v: string) => {
    const [y, m, d] = v.split('-').map(Number);
    return new Date(y, m - 1, d);
  };
  const timeLabel = (mins: number) =>
    new Date(2000, 0, 1, Math.floor(mins / 60), mins % 60).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

  function slotsFor(v: string): number[] {
    if (!v) return [];
    const day = parseDate(v);
    const now = shopNow();
    if (isoDate(day) < isoDate(now)) return [];
    const [open, close] = hours[day.getDay()] || [0, 0];
    let start = open;
    if (isoDate(day) === isoDate(now)) {
      const earliest = now.getHours() * 60 + now.getMinutes() + LEAD_MIN;
      start = Math.max(open, Math.ceil(earliest / STEP_MIN) * STEP_MIN);
    }
    const out: number[] = [];
    for (let t = start; t <= close - STEP_MIN; t += STEP_MIN) out.push(t);
    return out;
  }

  function emptyLabel(v: string) {
    if (!v) return 'Pick a date first';
    const [open, close] = hours[parseDate(v).getDay()] || [0, 0];
    return open >= close ? "We're closed this day" : 'No pickup times left this day';
  }

  // withDefault: fill in the first open day when the date is empty or past.
  // Only done when the cart opens; on submit a missing or past date is
  // cleared instead, so the customer has to pick one themselves.
  function refreshPickup(withDefault = false) {
    const today = shopNow();
    const last = new Date(today);
    last.setDate(today.getDate() + MAX_DAYS_AHEAD);
    dateInput.min = isoDate(today);
    dateInput.max = isoDate(last);
    // Default to the first day that still has pickup times.
    if (dateInput.value && (dateInput.value < dateInput.min || dateInput.value > dateInput.max)) dateInput.value = '';
    if (withDefault && !dateInput.value) {
      const d = new Date(today);
      while (!slotsFor(isoDate(d)).length && d < last) d.setDate(d.getDate() + 1);
      dateInput.value = isoDate(d);
    }
    const prev = timeSelect.value;
    const slots = slotsFor(dateInput.value);
    timeSelect.replaceChildren(
      ...(slots.length
        ? [new Option('Choose a time', ''), ...slots.map((t) => new Option(timeLabel(t), String(t)))]
        : [new Option(emptyLabel(dateInput.value), '')]),
    );
    timeSelect.value = slots.includes(Number(prev)) && prev !== '' ? prev : '';
  }
  dateInput.addEventListener('change', () => refreshPickup());

  function pickupText(date: string, time: string) {
    if (!date || time === '') return '';
    const day = parseDate(date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
    return `${day} at ${timeLabel(Number(time))}`;
  }

  const form = $<HTMLFormElement>('[data-cart-form]');
  const fallback = $<HTMLAnchorElement>('[data-cart-mailto]');
  fallback.textContent = dialog.dataset.email || '';
  fallback.href = `mailto:${dialog.dataset.email}`;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    refreshPickup(); // drop a date or time that has passed while the cart was open
    if (!form.reportValidity()) return;
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    window.location.href = mailtoHref(d);
  });

  function change(key: string, delta: number) {
    const l = lines.find((x) => x.key === key);
    if (!l) return;
    l.qty += delta;
    lines = lines.filter((x) => x.qty > 0);
    save();
    render();
  }

  let toastTimer: number | undefined;
  function toast(msg: string) {
    const t = $<HTMLElement>('[data-toast]');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('show'), 2200);
  }

  window.addEventListener('sip:add', (e) => {
    const item = (e as CustomEvent<Omit<Line, 'key' | 'qty'>>).detail;
    const key = `${item.id}:${item.size}`;
    const existing = lines.find((l) => l.key === key);
    if (existing) existing.qty += 1;
    else lines.push({ ...item, key, qty: 1 });
    save();
    render();
    toast(`Added ${item.size} ${item.name}`);
  });

  document.querySelectorAll('[data-cart-open]').forEach((b) =>
    b.addEventListener('click', () => {
      refreshPickup(true);
      dialog.showModal();
    }),
  );
  $('[data-cart-close]').addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  $('[data-cart-clear]').addEventListener('click', () => { lines = []; save(); render(); });
  window.addEventListener('storage', (e) => { if (e.key === KEY) { lines = load(); render(); } });

  render();
</script>
