---
import { contact } from '../data/menu';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <img src="/images/logo-160.webp" width="96" height="96" alt="Sip Society logo" loading="lazy" decoding="async" />
      <p class="tag">Cocoa · Smoothies · Lemonade · Beverages<br />Est. 2026</p>
    </div>
    <div>
      <h2>Visit</h2>
      <p>{contact.address}</p>
      <p><a href={`mailto:${contact.email}`}>{contact.email}</a><br /><a href={`tel:${contact.phone.replace(/\D/g, '')}`}>{contact.phone}</a></p>
    </div>
    <div>
      <h2>Hours</h2>
      <dl>
        {contact.hours.map(([d, h]) => (<><dt>{d}</dt><dd>{h}</dd></>))}
      </dl>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/menu/">Menu</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">© {year} Sip Society. All rights reserved.</div>
</footer>

<style>
  .site-footer { background: var(--cream); border-top: 1px solid var(--line); padding-top: 64px; font-size: 0.95rem; color: var(--muted); }
  .grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr 0.7fr; gap: 40px; }
  h2 { font-size: 1.4rem; margin-bottom: 14px; }
  .tag { font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-deep); margin-top: 14px; }
  a { color: var(--ink); text-decoration: none; }
  a:hover { color: var(--rose); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0; }
  dt { color: var(--ink); }
  dd { margin: 0; }
  .legal { border-top: 1px solid var(--line); margin-top: 48px; padding-block: 22px; font-size: 0.8rem; letter-spacing: 0.06em; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
