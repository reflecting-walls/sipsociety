---
import type { Drink } from '../data/menu';
import { money } from '../data/menu';

interface Props { drink: Drink; index: number; }
const { drink, index } = Astro.props;
const def = drink.sizes[1] ?? drink.sizes[0];
---

<article class:list={['item', { flip: index % 2 === 1 }]} id={drink.id} data-drink={drink.id} data-name={drink.name} data-img={drink.image}>
  <div class="media">
    <img
      src={drink.image}
      alt={drink.imageAlt}
      width="400"
      height="400"
      loading={index === 0 ? 'eager' : 'lazy'}
      fetchpriority={index === 0 ? 'high' : undefined}
      decoding="async"
    />
  </div>

  <div class="body">
    <p class="eyebrow">{drink.category}</p>
    <h2>{drink.name}</h2>
    <p class="tagline">{drink.tagline}</p>
    <p>{drink.description}</p>

    <ul class="badges" aria-label="Highlights">
      {drink.badges.map((b) => <li>{b}</li>)}
    </ul>

    <div class="details">
      <div>
        <h3>Ingredients</h3>
        <p>{drink.ingredients.join(', ')}</p>
      </div>
      <div>
        <h3>Allergens</h3>
        <p>{drink.allergens.length ? `Contains ${drink.allergens.join(', ').toLowerCase()}` : 'None of the top 9'}</p>
      </div>
    </div>
    {drink.note && <p class="note">{drink.note}</p>}

    <fieldset class="sizes">
      <legend>Choose a size</legend>
      <div class="opts">
        {drink.sizes.map((s) => (
          <label>
            <input
              type="radio"
              name={`size-${drink.id}`}
              value={s.id}
              checked={s.id === def.id}
              data-label={s.label}
              data-oz={s.oz}
              data-price={s.price}
              data-cal={s.calories}
            />
            <span><strong>{s.label}</strong><small>{s.oz} oz</small></span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="buy">
      <div class="stats" aria-live="polite">
        <span class="price" data-price-out>{money(def.price)}</span>
        <span class="cal"><span data-cal-out>{def.calories}</span> cal</span>
      </div>
      <button class="btn" type="button" data-add>Add to order</button>
    </div>
  </div>
</article>

<style>
  .item {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-block: clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 120px;
  }
  .item:last-child { border-bottom: 0; }
  .flip .media { order: 2; }
  .media img { width: 100%; max-width: 440px; margin-inline: auto; filter: drop-shadow(0 24px 30px rgba(168, 72, 106, 0.12)); }
  .eyebrow { margin-bottom: 10px; }
  h2 { margin-bottom: 6px; }
  .tagline { font: italic 500 1.3rem/1.4 var(--serif); color: var(--rose); margin-bottom: 16px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 22px; }
  .badges li { font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; background: var(--gold-soft); color: #6b5230; }
  .details { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; padding: 18px 0; border-block: 1px solid var(--line); margin-bottom: 18px; }
  .details h3 { font: 500 0.74rem/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: 8px; }
  .details p { margin: 0; font-size: 0.95rem; color: var(--muted); }
  .note { font-size: 0.9rem; color: var(--muted); font-style: italic; }
  .sizes { border: 0; padding: 0; margin: 0 0 22px; }
  legend { font: 500 0.74rem/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: 12px; padding: 0; }
  .opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 420px; }
  .opts label { position: relative; cursor: pointer; }
  .opts input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opts span {
    display: grid;
    place-items: center;
    gap: 2px;
    padding: 12px 8px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--white);
    transition: border-color 0.15s, background 0.15s;
  }
  .opts strong { font-weight: 500; font-size: 0.95rem; }
  .opts small { font-size: 0.78rem; color: var(--muted); }
  .opts input:checked + span { border-color: var(--rose); background: var(--blush); box-shadow: inset 0 0 0 1px var(--rose); }
  .opts input:focus-visible + span { outline: 2px solid var(--rose); outline-offset: 2px; }
  .opts label:hover span { border-color: var(--pink); }
  .buy { display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; max-width: 420px; }
  .stats { display: flex; align-items: baseline; gap: 14px; }
  .price { font: 600 2.2rem/1 var(--serif); color: var(--ink); }
  .cal { font-size: 0.9rem; color: var(--muted); }

  @media (max-width: 820px) {
    .item { grid-template-columns: 1fr; gap: 24px; }
    .flip .media { order: 0; }
    .media img { max-width: 300px; }
    .details { grid-template-columns: 1fr; gap: 14px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-drink]').forEach((card) => {
    const priceEl = card.querySelector("[data-price-out]")!;
    const calEl = card.querySelector("[data-cal-out]")!;
    const selected = () => card.querySelector<HTMLInputElement>('input[type=radio]:checked')!;
    const update = () => {
      const s = selected().dataset;
      priceEl.textContent = `$${Number(s.price).toFixed(2)}`;
      calEl.textContent = s.cal!;
    };
    card.querySelectorAll('input[type=radio]').forEach((r) => r.addEventListener('change', update));
    update();
    card.querySelector('[data-add]')!.addEventListener('click', () => {
      const s = selected().dataset;
      window.dispatchEvent(
        new CustomEvent('sip:add', {
          detail: {
            id: card.dataset.drink,
            name: card.dataset.name,
            img: card.dataset.img,
            size: s.label,
            oz: Number(s.oz),
            price: Number(s.price),
          },
        }),
      );
    });
  });
</script>
