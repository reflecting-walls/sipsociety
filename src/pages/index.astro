---
import Base from '../layouts/Base.astro';
import { drinks as allDrinks, money } from '../data/menu';
const drinks = allDrinks.filter((d) => !d.seasonal);
---

<Base title="Home" description="Sip Society is a kids' beverage bar serving cozy cocoa, pink lemonade, berry smoothies and caffeine-free babyccinos, made with real ingredients.">
  <link slot="head" rel="preload" as="image" href="/images/logo-720.webp" type="image/webp" fetchpriority="high" />

  <section class="hero">
    <div class="container hero-grid">
      <div class="copy">
        <p class="eyebrow">A beverage bar for little ones</p>
        <h1>Little sips,<br /><span class="script">big smiles.</span></h1>
        <p class="lead">Cozy cocoa, sparkling pink lemonade, berry smoothies and caffeine-free babyccinos. Kid-sized, made with real ingredients and served with a little extra sparkle.</p>
        <div class="ctas">
          <a class="btn" href="/menu/">View the menu</a>
          <a class="btn btn--ghost" href="/about/">Our story</a>
        </div>
      </div>
      <div class="art">
        <div class="ring">
          <img src="/images/logo-720.webp" width="440" height="440" alt="Sip Society, established 2026. Cocoa, smoothies, lemonade and beverages." fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <p class="eyebrow">The menu</p>
      <h2>Four sips, made just for them</h2>
      <div class="flourish">✦</div>
      <ul class="cards">
        {drinks.map((d) => (
          <li>
            <a href={`/menu/#${d.id}`} class="card">
              <img src={d.image} alt={d.imageAlt} width="400" height="400" loading="lazy" decoding="async" />
              <span class="cat">{d.category}</span>
              <h3>{d.name}</h3>
              <span class="from">from {money(d.sizes[0].price)}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--ghost" href="/menu/">See full menu & order</a>
    </div>
  </section>

  <section class="section section--blush">
    <div class="container center">
      <p class="eyebrow">Why parents love us</p>
      <h2>Thoughtfully made for little sippers</h2>
      <div class="flourish">✦</div>
      <div class="values">
        <div>
          <span class="icon" aria-hidden="true">❀</span>
          <h3>Real ingredients</h3>
          <p>Fresh-squeezed lemons, whole fruit and real cocoa. Nothing artificial, ever.</p>
        </div>
        <div>
          <span class="icon" aria-hidden="true">☾</span>
          <h3>Caffeine-free fun</h3>
          <p>Our “coffee” is a babyccino, so kids can sip along with you, minus the jitters.</p>
        </div>
        <div>
          <span class="icon" aria-hidden="true">✿</span>
          <h3>Kid-safe &amp; kid-sized</h3>
          <p>Warm drinks served at a sippable temperature in sizes made for small hands.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container quote center">
      <p class="eyebrow">Kind words</p>
      <blockquote>
        “Our Saturday ritual: my latte, her babyccino and a shared pink lemonade. It’s the sweetest little spot in town.”
      </blockquote>
      <p class="who">A happy Sip Society parent</p>
    </div>
  </section>

  <section class="cta">
    <div class="container center">
      <h2>Ready for a sip?</h2>
      <p>Choose a drink, pick a size and send us your order. We’ll have it ready.</p>
      <a class="btn btn--gold" href="/menu/">Start an order</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, var(--blush) 0%, var(--white) 100%); padding-block: clamp(48px, 8vw, 104px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 48px; }
  .hero h1 { margin-bottom: 22px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .ring {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow), 0 0 0 10px rgba(255, 255, 255, 0.7), 0 0 0 11px var(--gold);
    display: grid;
    place-items: center;
    padding: 6%;
  }

  .cards { list-style: none; padding: 0; margin: 0 0 44px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 18px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    background: var(--white);
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    height: 100%;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--gold); color: var(--ink); }
  .card img { width: 78%; margin-bottom: 16px; }
  .cat { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-deep); }
  .card h3 { font-size: 1.5rem; margin: 6px 0 6px; }
  .from { font-size: 0.9rem; color: var(--rose); }

  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: center; }
  .values > div { background: var(--white); border-radius: var(--radius); padding: 36px 28px; }
  .icon { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold-deep); font-size: 1.4rem; margin-bottom: 16px; }
  .values p { color: var(--muted); margin: 0; }

  .quote blockquote { font: italic 500 clamp(1.6rem, 3.2vw, 2.4rem)/1.35 var(--serif); max-width: 46rem; margin: 0 auto 18px; }
  .who { font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }

  .cta { background: var(--ink); color: var(--gold-soft); padding-block: 80px; }
  .cta h2 { color: var(--white); }
  .cta p { margin-bottom: 28px; }

  @media (max-width: 960px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero .lead { margin-inline: auto; }
    .ctas { justify-content: center; }
    .art { order: -1; }
    .ring { width: min(80%, 320px); }
    .values { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) { .cards { gap: 14px; } .card { padding: 16px 10px 20px; } .card h3 { font-size: 1.2rem; } }
</style>
