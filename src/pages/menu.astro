---
import Base from '../layouts/Base.astro';
import MenuItem from '../components/MenuItem.astro';
import { drinks, seasons, seasonFor } from '../data/menu';

// Build-time guess; the script below switches to the visitor's actual season on load.
const startId = seasonFor(new Date());
const start = seasons.findIndex((s) => s.id === startId);
const ordered = [...seasons.slice(start), ...seasons.slice(0, start)];
const menus = ordered.map((s) => ({ season: s, items: drinks.filter((d) => d.seasons.includes(s.id)).sort((a, b) => Number(!!b.seasonal) - Number(!!a.seasonal)) }));
---

<Base title="Menu" description="The Sip Society seasonal menu: cocoa and latte mixes for winter and fall, bottled pink lemonade and berry smoothies for spring and summer, plus seasonal specials, all dairy-free, with ingredients, calories and prices.">
  <section class="intro">
    <div class="container center">
      <p class="eyebrow">Our seasonal menu</p>
      <h1>Sips for every <span class="script">little season</span></h1>
      <p class="lead">Our menu changes with the seasons. Cold drinks come bottled and chilled, and our warm drinks come as cocoa and steamer mixes to make at home. Pick a size to see its price and calories, then add it to your order.</p>
      <div class="tabs" role="tablist" aria-label="Seasons" data-tabs>
        {menus.map(({ season }, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${season.id}`}
            aria-controls={`menu-${season.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-season={season.id}
          >
            <span class="ico" aria-hidden="true">{season.icon}</span>
            {season.name}
            <span class="now" hidden={i !== 0}>Now</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {menus.map(({ season, items }, i) => (
    <section
      class="season"
      role="tabpanel"
      id={`menu-${season.id}`}
      aria-labelledby={`tab-${season.id}`}
      data-panel={season.id}
      hidden={i !== 0}
    >
      <div class="container">
        <header class="season-head center">
          <p class="eyebrow">{season.name} menu</p>
          <p class="season-tag">{season.tagline}</p>
          <nav class="jump" aria-label={`${season.name} drinks`}>
            {items.map((d) => <a href={`#${season.id}-${d.id}`}>{d.name}</a>)}
          </nav>
        </header>
        {items.map((d, j) => <MenuItem drink={d} index={j} uid={`${season.id}-${d.id}`} eager={i === 0 && j === 0} />)}
      </div>
    </section>
  ))}

  <section class="section section--blush">
    <div class="container center small">
      <h2>Good to know</h2>
      <p>Seasonal specials are available while their season lasts. Everything is dairy-free. Bottled drinks are made fresh, kept at 41°F or colder and should stay refrigerated. Mixes are shelf-stable. Calories are approximate. Please tell us about allergies when you order.</p>
      <p><strong>These products were produced in a home kitchen not inspected by a health department that may also process common food allergens.</strong></p>
    </div>
  </section>
</Base>

<style>
  .intro { background: linear-gradient(180deg, var(--blush), var(--white)); padding-block: clamp(56px, 8vw, 96px) 24px; }
  .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }
  .tabs button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--ink);
    font: 500 0.8rem/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--white);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .tabs button:hover { background: var(--blush); color: var(--rose); }
  .tabs button[aria-selected='true'] { background: var(--rose); border-color: var(--rose); color: var(--white); }
  .tabs button:focus-visible { outline: 2px solid var(--rose); outline-offset: 3px; }
  .ico { font-size: 1rem; letter-spacing: 0; color: var(--gold-deep); }
  .tabs button[aria-selected='true'] .ico { color: var(--gold-soft); }
  .now {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--gold-soft);
    color: #6b5230;
  }
  .season-head { padding-top: clamp(28px, 4vw, 44px); }
  .season-tag { font: italic 500 1.5rem/1.3 var(--serif); color: var(--rose); margin: 0; }
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; margin-top: 14px; }
  .jump a { font-size: 0.85rem; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); }
  .jump a:hover { color: var(--rose); border-color: var(--rose); }
  .small { max-width: 44rem; }
  .small p { color: var(--muted); }
</style>

<script>
  import { seasons, seasonFor, type SeasonId } from '../data/menu';

  const tablist = document.querySelector<HTMLElement>('[data-tabs]')!;
  const tabs = () => [...tablist.querySelectorAll<HTMLButtonElement>('[role=tab]')];

  const select = (id: string, focus = false) => {
    tabs().forEach((t) => {
      const on = t.dataset.season === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
  };

  // Put the current season first and mark it "Now".
  const current = seasonFor(new Date());
  const start = seasons.findIndex((s) => s.id === current);
  [...seasons.slice(start), ...seasons.slice(0, start)].forEach((s) => {
    const t = tablist.querySelector<HTMLElement>(`[data-season="${s.id}"]`)!;
    t.querySelector<HTMLElement>('.now')!.hidden = s.id !== current;
    tablist.append(t);
  });

  // Links like /menu/#fall open that season; /menu/#hot-chocolate (from Home)
  // opens a season serving that drink, preferring the current one.
  const fromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    if (!h) return { season: current };
    if (seasons.some((s) => s.id === h)) return { season: h as SeasonId };
    const m = h.match(/^(winter|spring|summer|fall)-(.+)$/);
    if (m && document.getElementById(h)) return { season: m[1] as SeasonId, target: h };
    const order = [current, ...seasons.map((s) => s.id).filter((s) => s !== current)];
    const season = order.find((s) => document.getElementById(`${s}-${h}`));
    return season ? { season, target: `${season}-${h}` } : { season: current };
  };

  const applyHash = () => {
    const { season, target } = fromHash();
    select(season);
    if (target) requestAnimationFrame(() => document.getElementById(target)?.scrollIntoView());
  };
  applyHash();
  window.addEventListener('hashchange', applyHash);

  tablist.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[role=tab]');
    if (!t) return;
    select(t.dataset.season!);
    history.replaceState(null, '', `#${t.dataset.season}`);
  });

  tablist.addEventListener('keydown', (e) => {
    const list = tabs();
    const i = list.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: list.length - 1 }[e.key];
    if (next === undefined) return;
    e.preventDefault();
    const t = list[(next + list.length) % list.length];
    select(t.dataset.season!, true);
    history.replaceState(null, '', `#${t.dataset.season}`);
  });

</script>
